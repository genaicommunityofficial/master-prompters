# Participant site (Vercel + local Vite). Never put the service-role key here.
#
# Local: leave VITE_API_BASE_URL empty so Vite proxies /api to FastAPI for admin.
# Vercel: set the two VITE_SUPABASE_* values; leave VITE_API_BASE_URL empty.
# The public site talks to Supabase directly. Admin/eval still run on the laptop.

VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
